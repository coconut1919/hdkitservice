<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="STD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <createMissingDirectories>true</createMissingDirectories>
        <file>${LOG_DIR}/std.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/std.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="RUN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <createMissingDirectories>true</createMissingDirectories>
        <file>${LOG_DIR}/run.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/run.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="INTERFACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <createMissingDirectories>true</createMissingDirectories>
        <file>${LOG_DIR}/interface.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/interface.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="CALL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <createMissingDirectories>true</createMissingDirectories>
        <file>${LOG_DIR}/call.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/call.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="com.huaweicloud.hdkitservice.interface" level="INFO" additivity="false">
        <appender-ref ref="INTERFACE_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.huaweicloud.hdkitservice.call" level="INFO" additivity="false">
        <appender-ref ref="CALL_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.huaweicloud.hdkitservice.HdkitServiceApplication" level="INFO" additivity="false">
        <appender-ref ref="STD_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.huaweicloud.hdkitservice" level="INFO" additivity="false">
        <appender-ref ref="RUN_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="STD_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
